+                alpha_lm=alpha_lm,
+                beam_width=5,
+                topk_t=6,
+                digit_neutral=False,
+                routing=eff_routing,
+            )
+            return cfg, target_lm, None
+
+        self.char_lm.validate_mode(digit_neutral=True, allow_mismatched_schema=False)
