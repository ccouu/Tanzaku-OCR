+            use_bwd.validate_mode(digit_neutral=True, allow_mismatched_schema=False)
+        cfg = DecodeConfig(
+            mode=mode,
+            alpha_lm=alpha_lm,
+            beam_width=5,
+            topk_t=6,
+            digit_neutral=True,
